{
  "extends": "@velora/config/typescript/vue.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules", "playwright-report", "test-results"]
}
